{
  "name": "@the-last-stack/laststack.ui",
  "private": false,
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A small React component library themed from six colors — two brand, four semantic — with the rest color-mixed from them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-last-stack/laststack.ui.git"
  },
  "homepage": "https://github.com/the-last-stack/laststack.ui#readme",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "tailwind",
    "theme"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./color": {
      "types": "./dist-lib/color/index.d.ts",
      "import": "./dist-lib/color.js"
    },
    "./styles.css": "./dist-lib/index.css",
    "./tailwind.css": "./src/tailwind.css",
    "./theme.css": "./src/theme.css",
    "./components.css": "./src/components/components.css"
  },
  "files": [
    "dist-lib",
    "src/styles.css",
    "src/tailwind.css",
    "src/theme.css",
    "src/components/components.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "node scripts/check-mode-cascade.mjs && tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts && node scripts/check-palette-parity.mjs",
    "lint": "eslint .",
    "check:cascade": "node scripts/check-mode-cascade.mjs",
    "check:palette": "node scripts/check-palette-parity.mjs",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lucide-react": "^1.18.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
